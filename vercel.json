{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/ikebana",
      "destination": "/house.html#ikebana",
      "permanent": true
    },
    {
      "source": "/ikebana.html",
      "destination": "/house.html#ikebana",
      "permanent": true
    },
    {
      "source": "/accesibility",
      "destination": "/accessibility.html",
      "permanent": true
    },
    {
      "source": "/accesibility.html",
      "destination": "/accessibility.html",
      "permanent": true
    },
    {
      "source": "/arrangements",
      "destination": "/collections.html",
      "permanent": true
    },
    {
      "source": "/bag",
      "destination": "/enquiries.html",
      "permanent": true
    },
    {
      "source": "/bag.html",
      "destination": "/enquiries.html",
      "permanent": true
    },
    {
      "source": "/atelier",
      "destination": "/collections.html#commissions",
      "permanent": true
    },
    {
      "source": "/atelier.html",
      "destination": "/collections.html#commissions",
      "permanent": true
    },
    {
      "source": "/archive",
      "destination": "/house.html#selected-work",
      "permanent": true
    },
    {
      "source": "/archive.html",
      "destination": "/house.html#selected-work",
      "permanent": true
    },
    {
      "source": "/bespoke-events",
      "destination": "/collections.html#commissions",
      "permanent": true
    },
    {
      "source": "/bespoke-events.html",
      "destination": "/collections.html#commissions",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
